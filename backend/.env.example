REELWEAVE_WORKING_ROOT=./var/reelweave
REELWEAVE_UPLOAD_ROOT=./var/reelweave/uploads
REELWEAVE_OUTPUT_ROOT=./var/reelweave/outputs
REELWEAVE_MAX_FILE_SIZE_MB=200
REELWEAVE_MAX_AUDIO_FILE_SIZE_MB=100
REELWEAVE_MAX_CLIPS=20
REELWEAVE_QUEUE_SIZE=4
REELWEAVE_RETENTION_SECONDS=3600
REELWEAVE_CLEANUP_INTERVAL_SECONDS=300
REELWEAVE_ALLOWED_ORIGINS=http://localhost:5173
REELWEAVE_FFMPEG_PATH=ffmpeg
REELWEAVE_FFPROBE_PATH=ffprobe
REELWEAVE_SUBPROCESS_TIMEOUT_SECONDS=1800
